---
// Methodology Section - McKinsey Style
---

<section id="metodologia" class="section-container bg-gradient-to-br from-white via-gray-50 to-white dark:from-deeppro-dark dark:via-gray-900 dark:to-deeppro-dark observe-fade">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center space-x-2 bg-deeppro-cyan/10 px-6 py-2 rounded-full mb-6">
        <svg class="w-4 h-4 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-semibold text-deeppro-cyan">Enfoque Probado</span>
      </div>
      <h2 class="section-title">Nuestra Metodología</h2>
      <p class="section-subtitle mt-6">
        Un framework estructurado que garantiza resultados medibles en cada implementación
      </p>
    </div>

    <!-- Methodology Steps -->
    <div class="grid lg:grid-cols-4 gap-8 relative">
      <!-- Connection Line -->
      <div class="hidden lg:block absolute top-20 left-0 right-0 h-0.5 bg-gradient-to-r from-deeppro-cyan via-blue-500 to-purple-500"></div>

      <!-- Step 1: Discovery -->
      <div class="relative">
        <div class="glass-card hover-lift text-center">
          <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 w-12 h-12 bg-gradient-to-br from-deeppro-cyan to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-xl">
            1
          </div>
          <div class="pt-8">
            <div class="w-16 h-16 mx-auto bg-deeppro-cyan/10 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Discovery</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
              Análisis profundo de procesos actuales, sistemas existentes y necesidades específicas.
            </p>
            <div class="space-y-2 text-xs text-left">
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-deeppro-cyan rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Mapeo de procesos</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-deeppro-cyan rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Análisis de datos</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-deeppro-cyan rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Identificación de gaps</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Design -->
      <div class="relative">
        <div class="glass-card hover-lift text-center">
          <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-xl">
            2
          </div>
          <div class="pt-8">
            <div class="w-16 h-16 mx-auto bg-blue-500/10 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Diseño</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
              Arquitectura de solución personalizada, modelado de datos y definición de KPIs.
            </p>
            <div class="space-y-2 text-xs text-left">
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Data modeling</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Dashboard wireframes</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">KPI definition</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: Implementation -->
      <div class="relative">
        <div class="glass-card hover-lift text-center">
          <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-xl">
            3
          </div>
          <div class="pt-8">
            <div class="w-16 h-16 mx-auto bg-purple-500/10 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Implementación</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
              Desarrollo ágil con entregas iterativas, testing exhaustivo y capacitación hands-on.
            </p>
            <div class="space-y-2 text-xs text-left">
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-purple-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Build & deploy</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-purple-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">User training</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-purple-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">UAT & validation</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Optimization -->
      <div class="relative">
        <div class="glass-card hover-lift text-center">
          <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 w-12 h-12 bg-gradient-to-br from-pink-500 to-red-500 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-xl">
            4
          </div>
          <div class="pt-8">
            <div class="w-16 h-16 mx-auto bg-pink-500/10 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Optimización</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
              Mejora continua basada en uso real, expansión gradual y soporte proactivo.
            </p>
            <div class="space-y-2 text-xs text-left">
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Performance tuning</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Feature enhancement</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
                <span class="text-gray-600 dark:text-gray-400">Ongoing support</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <div class="mt-20 glass-card p-10">
      <div class="flex items-center justify-between mb-8">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Timeline Típico</h3>
        <div class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>6-12 semanas</span>
        </div>
      </div>

      <div class="relative">
        <!-- Progress bar -->
        <div class="absolute top-6 left-0 right-0 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-deeppro-cyan via-blue-500 to-purple-500 w-3/4"></div>
        </div>

        <!-- Milestones -->
        <div class="grid grid-cols-4 gap-4 relative">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto bg-deeppro-cyan rounded-full flex items-center justify-center text-white font-bold mb-3 relative z-10">
              ✓
            </div>
            <div class="text-xs font-semibold text-gray-900 dark:text-white">Semana 1-2</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">Discovery</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto bg-blue-500 rounded-full flex items-center justify-center text-white font-bold mb-3 relative z-10">
              ✓
            </div>
            <div class="text-xs font-semibold text-gray-900 dark:text-white">Semana 3-4</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">Diseño</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto bg-purple-500 rounded-full flex items-center justify-center text-white font-bold mb-3 relative z-10">
              ✓
            </div>
            <div class="text-xs font-semibold text-gray-900 dark:text-white">Semana 5-8</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">Build</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto bg-gray-300 dark:bg-gray-600 rounded-full flex items-center justify-center text-white font-bold mb-3 relative z-10">
              →
            </div>
            <div class="text-xs font-semibold text-gray-900 dark:text-white">Semana 9+</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">Ongoing</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
