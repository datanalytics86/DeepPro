---
// Portfolio / Casos de Éxito Section
const casos = [
  {
    title: "Dashboard de Producción",
    client: "Empresa Productiva",
    description: "Sistema integral de monitoreo de producción en tiempo real con KPIs operacionales, análisis de eficiencia y detección de cuellos de botella.",
    technologies: ["Power BI", "Excel", "Power Query", "DAX"],
    results: [
      "Reducción 30% en tiempo de reportes",
      "Visibilidad en tiempo real",
      "Identificación proactiva de problemas"
    ],
    image: "produccion",
    category: "Power BI"
  },
  {
    title: "Control de Flujo de Caja",
    client: "Proyectos Industriales",
    description: "Herramienta de control financiero para gestión de múltiples proyectos simultáneos, con proyecciones y alertas automáticas de desviaciones.",
    technologies: ["Power BI", "Excel", "SQL", "Power Pivot"],
    results: [
      "Control preciso de cash flow",
      "Alertas tempranas de desviaciones",
      "Proyecciones automatizadas"
    ],
    image: "flujo-caja",
    category: "Análisis Financiero"
  },
  {
    title: "Control de Horas Hombre",
    client: "Empresa de Ingeniería",
    description: "Sistema de seguimiento y análisis de recursos humanos en proyectos de ingeniería, optimizando asignación y costos.",
    technologies: ["Power BI", "Excel", "VBA", "DAX"],
    results: [
      "Optimización 25% en asignación",
      "Reducción de sobrecostos",
      "Visibilidad por proyecto y área"
    ],
    image: "hh-ingenieria",
    category: "Recursos Humanos"
  },
  {
    title: "Programa Minero P6",
    client: "Proyecto Minero",
    description: "Implementación completa de Primavera P6 para gestión de programa de construcción minera, con control integrado de cronograma y recursos.",
    technologies: ["Primavera P6", "Power BI", "Excel", "MS Project"],
    results: [
      "Control de 200+ actividades",
      "Integración con equipos externos",
      "Reportabilidad ejecutiva automatizada"
    ],
    image: "mineria-p6",
    category: "Gestión de Proyectos"
  }
];

const categories = ["Todos", "Power BI", "Análisis Financiero", "Recursos Humanos", "Gestión de Proyectos"];
---

<section id="casos" class="section-container bg-white dark:bg-deeppro-dark observe-fade">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="section-title">Casos de Éxito</h2>
      <p class="section-subtitle mt-4">
        Proyectos reales que han transformado la gestión de datos en empresas chilenas
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {categories.map((category) => (
        <button
          data-filter={category}
          class="filter-btn px-6 py-2 rounded-lg font-medium transition-all duration-300 border-2 border-gray-200 dark:border-gray-700 text-gray-700 dark:text-deeppro-gray hover:border-deeppro-cyan hover:text-deeppro-cyan"
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Cases Grid -->
    <div class="grid md:grid-cols-2 gap-8" id="casos-grid">
      {casos.map((caso) => (
        <article
          data-category={caso.category}
          class="caso-card card group cursor-pointer overflow-hidden"
        >
          <!-- Project Screenshot -->
          <div class="relative h-64 -mx-6 -mt-6 mb-6 bg-gray-100 dark:bg-gray-800 overflow-hidden group-hover:scale-105 transition-transform duration-300">
            <img
              src={`/images/dashboard-${caso.image}.svg`}
              alt={`Screenshot de ${caso.title}`}
              class="w-full h-full object-cover object-top"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-deeppro-dark via-transparent to-transparent opacity-60"></div>
            <div class="absolute top-4 right-4 bg-deeppro-cyan text-white px-3 py-1 rounded-full text-xs font-semibold">
              {caso.category}
            </div>
          </div>

          <!-- Content -->
          <div class="space-y-4">
            <div>
              <span class="text-sm text-deeppro-cyan font-semibold">{caso.client}</span>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1 group-hover:text-deeppro-cyan transition-colors">
                {caso.title}
              </h3>
            </div>

            <p class="text-gray-600 dark:text-deeppro-gray">
              {caso.description}
            </p>

            <!-- Technologies -->
            <div class="flex flex-wrap gap-2">
              {caso.technologies.map((tech) => (
                <span class="px-3 py-1 text-xs font-medium bg-deeppro-cyan/10 text-deeppro-cyan rounded-full">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Results -->
            <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
              <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Resultados:</h4>
              <ul class="space-y-1">
                {caso.results.map((result) => (
                  <li class="flex items-start space-x-2 text-sm text-gray-700 dark:text-deeppro-gray">
                    <svg class="w-4 h-4 text-deeppro-cyan mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{result}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const casosCards = document.querySelectorAll('.caso-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');

      // Update active button
      filterButtons.forEach(btn => {
        btn.classList.remove('border-deeppro-cyan', 'text-deeppro-cyan', 'bg-deeppro-cyan/10');
        btn.classList.add('border-gray-200', 'dark:border-gray-700');
      });
      button.classList.add('border-deeppro-cyan', 'text-deeppro-cyan', 'bg-deeppro-cyan/10');
      button.classList.remove('border-gray-200', 'dark:border-gray-700');

      // Filter cards
      casosCards.forEach(card => {
        const htmlCard = card as HTMLElement;
        if (filter === 'Todos' || card.getAttribute('data-category') === filter) {
          htmlCard.style.display = 'block';
          setTimeout(() => {
            htmlCard.style.opacity = '1';
            htmlCard.style.transform = 'scale(1)';
          }, 10);
        } else {
          htmlCard.style.opacity = '0';
          htmlCard.style.transform = 'scale(0.9)';
          setTimeout(() => {
            htmlCard.style.display = 'none';
          }, 300);
        }
      });
    });
  });

  // Set "Todos" as active by default
  filterButtons[0]?.classList.add('border-deeppro-cyan', 'text-deeppro-cyan', 'bg-deeppro-cyan/10');
</script>

<style>
  .caso-card {
    opacity: 1;
    transform: scale(1);
    transition: all 0.3s ease;
  }
</style>
