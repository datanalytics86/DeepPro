---
// Contact Section
---

<section id="contacto" class="section-container bg-gradient-to-br from-gray-50 to-blue-50 dark:from-deeppro-dark/50 dark:to-deeppro-dark observe-fade">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="section-title">Trabajemos Juntos</h2>
      <p class="section-subtitle mt-4">
        ¿Tienes un proyecto en mente? Conversemos sobre cómo puedo ayudarte
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Left - Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Información de Contacto
          </h3>
          <p class="text-gray-600 dark:text-deeppro-gray text-lg">
            Estoy disponible para nuevos proyectos y consultas. No dudes en contactarme por cualquiera de estos medios.
          </p>
        </div>

        <!-- Contact Cards -->
        <div class="space-y-4">
          <!-- Email -->
          <a
            href="mailto:nicolas.andrade@deeppro.cl"
            class="flex items-start space-x-4 p-4 rounded-xl bg-white dark:bg-deeppro-dark/50 hover:shadow-lg transition-shadow border border-gray-200 dark:border-gray-700"
          >
            <div class="w-12 h-12 bg-deeppro-cyan/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-500 dark:text-deeppro-gray">Email</div>
              <div class="text-gray-900 dark:text-white font-semibold">nicolas.andrade@deeppro.cl</div>
            </div>
          </a>

          <!-- Phone -->
          <a
            href="tel:+56987550637"
            class="flex items-start space-x-4 p-4 rounded-xl bg-white dark:bg-deeppro-dark/50 hover:shadow-lg transition-shadow border border-gray-200 dark:border-gray-700"
          >
            <div class="w-12 h-12 bg-deeppro-cyan/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-500 dark:text-deeppro-gray">Teléfono</div>
              <div class="text-gray-900 dark:text-white font-semibold">+569 8755 0637</div>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-start space-x-4 p-4 rounded-xl bg-white dark:bg-deeppro-dark/50 border border-gray-200 dark:border-gray-700">
            <div class="w-12 h-12 bg-deeppro-cyan/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-500 dark:text-deeppro-gray">Ubicación</div>
              <div class="text-gray-900 dark:text-white font-semibold">Santiago, Chile</div>
            </div>
          </div>
        </div>

        <!-- Availability -->
        <div class="bg-gradient-to-r from-deeppro-cyan/10 to-blue-500/10 dark:from-deeppro-cyan/20 dark:to-blue-500/20 rounded-xl p-6 border-l-4 border-deeppro-cyan">
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-deeppro-cyan flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h4 class="font-bold text-gray-900 dark:text-white mb-1">Disponibilidad</h4>
              <p class="text-gray-700 dark:text-deeppro-gray">
                Actualmente disponible para nuevos proyectos. Respondo consultas en menos de 24 horas.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right - Contact Form -->
      <div class="card">
        <form id="contact-form" class="space-y-6">
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-deeppro-light-gray mb-2">
              Nombre *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-deeppro-dark/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent transition-all"
              placeholder="Tu nombre"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-deeppro-light-gray mb-2">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-deeppro-dark/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent transition-all"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 dark:text-deeppro-light-gray mb-2">
              Teléfono
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-deeppro-dark/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent transition-all"
              placeholder="+56 9 1234 5678"
            />
          </div>

          <!-- Service Interest -->
          <div>
            <label for="service" class="block text-sm font-medium text-gray-700 dark:text-deeppro-light-gray mb-2">
              Servicio de Interés
            </label>
            <select
              id="service"
              name="service"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-deeppro-dark/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent transition-all"
            >
              <option value="">Selecciona un servicio</option>
              <option value="powerbi">Implementación Power BI</option>
              <option value="gestion">Gestión de Proyectos (P6)</option>
              <option value="analisis">Análisis de Datos</option>
              <option value="excel">Excel Avanzado</option>
              <option value="consultoria">Consultoría General</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 dark:text-deeppro-light-gray mb-2">
              Mensaje *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-deeppro-dark/50 text-gray-900 dark:text-white focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent transition-all resize-none"
              placeholder="Cuéntame sobre tu proyecto..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full btn-primary"
          >
            Enviar Mensaje
          </button>

          <!-- Success/Error Messages -->
          <div id="form-message" class="hidden p-4 rounded-lg"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formMessage = document.getElementById('form-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    // Create email content
    const emailBody = `
Nuevo contacto desde el portfolio de DeepPro

Nombre: ${data.name}
Email: ${data.email}
Teléfono: ${data.phone || 'No proporcionado'}
Servicio: ${data.service || 'No especificado'}

Mensaje:
${data.message}
    `.trim();

    // Show loading state
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitButton.textContent;
    submitButton.textContent = 'Enviando...';
    submitButton.disabled = true;

    // Simulate form submission (replace with actual Formspree or API endpoint)
    try {
      // For demo purposes, create a mailto link
      const mailtoLink = `mailto:nicolas.andrade@deeppro.cl?subject=Contacto desde Portfolio&body=${encodeURIComponent(emailBody)}`;
      window.location.href = mailtoLink;

      // Show success message
      if (formMessage) {
        formMessage.className = 'p-4 rounded-lg bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200 border border-green-300 dark:border-green-700';
        formMessage.textContent = '¡Gracias! Tu mensaje ha sido enviado. Te contactaré pronto.';
        formMessage.classList.remove('hidden');
      }

      // Reset form
      form.reset();

      // Hide message after 5 seconds
      setTimeout(() => {
        formMessage?.classList.add('hidden');
      }, 5000);
    } catch (error) {
      // Show error message
      if (formMessage) {
        formMessage.className = 'p-4 rounded-lg bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-200 border border-red-300 dark:border-red-700';
        formMessage.textContent = 'Hubo un error al enviar el mensaje. Por favor, intenta nuevamente.';
        formMessage.classList.remove('hidden');
      }
    } finally {
      // Restore button state
      submitButton.textContent = originalText;
      submitButton.disabled = false;
    }
  });
</script>
