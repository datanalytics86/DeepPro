---
// Hero Section Component
---

<section id="hero" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-white via-blue-50 to-cyan-50 dark:from-deeppro-dark dark:via-deeppro-dark dark:to-deeppro-dark/95 pt-16">
  <div class="section-container">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div class="space-y-8">
        <div class="space-y-4">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
            <span class="text-gray-900 dark:text-white">Transformando</span>
            <br />
            <span class="bg-gradient-to-r from-deeppro-cyan to-blue-600 bg-clip-text text-transparent">
              Datos en Decisiones
            </span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-deeppro-gray max-w-xl">
            Soluciones de Business Intelligence accesibles y prácticas para empresas que buscan resultados sin la complejidad de grandes ERP.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#casos" class="btn-primary text-center">
            Ver Casos de Éxito
          </a>
          <a href="#contacto" class="btn-secondary text-center">
            Trabajemos Juntos
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-gray-200 dark:border-gray-800">
          <div>
            <div class="text-3xl font-bold text-deeppro-cyan">10+</div>
            <div class="text-sm text-gray-600 dark:text-deeppro-gray">Proyectos</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-deeppro-cyan">100%</div>
            <div class="text-sm text-gray-600 dark:text-deeppro-gray">Satisfacción</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-deeppro-cyan">15+</div>
            <div class="text-sm text-gray-600 dark:text-deeppro-gray">Años Exp.</div>
          </div>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="relative">
        <div class="relative z-10">
          <!-- Dashboard Mockup -->
          <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl p-6 space-y-4 border border-gray-200 dark:border-gray-700">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-700">
              <div class="flex items-center space-x-3">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
              </div>
              <span class="text-sm text-gray-500 dark:text-gray-400">Dashboard</span>
            </div>

            <!-- Chart Placeholder -->
            <div class="space-y-3">
              <div class="h-8 bg-gradient-to-r from-deeppro-cyan/20 to-blue-500/20 rounded"></div>
              <div class="grid grid-cols-3 gap-3">
                <div class="h-24 bg-gradient-to-br from-deeppro-cyan/30 to-deeppro-cyan/10 rounded flex items-end p-2">
                  <div class="w-full h-3/4 bg-deeppro-cyan rounded-t"></div>
                </div>
                <div class="h-24 bg-gradient-to-br from-blue-500/30 to-blue-500/10 rounded flex items-end p-2">
                  <div class="w-full h-1/2 bg-blue-500 rounded-t"></div>
                </div>
                <div class="h-24 bg-gradient-to-br from-purple-500/30 to-purple-500/10 rounded flex items-end p-2">
                  <div class="w-full h-2/3 bg-purple-500 rounded-t"></div>
                </div>
              </div>
              <div class="space-y-2">
                <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-3/4"></div>
                <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Background Decoration -->
        <div class="absolute -top-4 -right-4 w-72 h-72 bg-deeppro-cyan/10 rounded-full blur-3xl -z-0"></div>
        <div class="absolute -bottom-4 -left-4 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl -z-0"></div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="flex justify-center mt-16">
      <a href="#sobre-mi" class="animate-bounce">
        <svg class="w-6 h-6 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
