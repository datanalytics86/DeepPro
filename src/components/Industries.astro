---
// Industries Section - McKinsey Style
const industries = [
  {
    name: "Minería",
    icon: "mining",
    description: "Optimización de procesos de extracción, control de proyectos y análisis de producción.",
    projects: "8+",
    impact: "+25% eficiencia operacional"
  },
  {
    name: "Manufactura",
    icon: "manufacturing",
    description: "Monitoreo en tiempo real de líneas de producción y gestión de inventarios.",
    projects: "12+",
    impact: "-30% tiempo de reportes"
  },
  {
    name: "Ingeniería",
    icon: "engineering",
    description: "Control de HH, gestión de proyectos y seguimiento de avance multidisciplinario.",
    projects: "15+",
    impact: "ROI 10x en primer año"
  },
  {
    name: "Servicios",
    icon: "services",
    description: "Análisis de rentabilidad por proyecto y optimización de recursos.",
    projects: "10+",
    impact: "+40% precisión decisiones"
  }
];
---

<section id="industrias" class="section-container bg-white dark:bg-deeppro-dark observe-fade">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center space-x-2 bg-deeppro-cyan/10 px-6 py-2 rounded-full mb-6">
        <svg class="w-4 h-4 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        <span class="text-sm font-semibold text-deeppro-cyan">Experiencia Vertical</span>
      </div>
      <h2 class="section-title">Industrias que Servimos</h2>
      <p class="section-subtitle mt-6">
        Experiencia profunda en sectores clave de la economía chilena
      </p>
    </div>

    <!-- Industries Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {industries.map((industry, index) => (
        <div class={`glass-card hover-lift stagger-${index + 1}`}>
          <!-- Icon -->
          <div class="w-16 h-16 bg-gradient-to-br from-deeppro-cyan to-blue-500 rounded-2xl flex items-center justify-center mb-6">
            {industry.icon === 'mining' && (
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            )}
            {industry.icon === 'manufacturing' && (
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            )}
            {industry.icon === 'engineering' && (
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
              </svg>
            )}
            {industry.icon === 'services' && (
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            )}
          </div>

          <!-- Content -->
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{industry.name}</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">{industry.description}</p>

          <!-- Stats -->
          <div class="flex items-center justify-between pt-6 border-t border-gray-200 dark:border-gray-700">
            <div>
              <div class="text-2xl font-bold gradient-text">{industry.projects}</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">Proyectos</div>
            </div>
            <div class="text-right">
              <div class="text-sm font-semibold text-green-500">{industry.impact}</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">Impacto promedio</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Additional Info -->
    <div class="mt-16 glass-card p-10 text-center">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
        ¿Tu industria no está listada?
      </h3>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
        Nuestra metodología es agnóstica a la industria. Si manejas datos y proyectos, podemos ayudarte a optimizar tus procesos.
      </p>
      <a href="#contacto" class="btn-secondary inline-block">
        Conversemos sobre tu Caso
      </a>
    </div>
  </div>
</section>
