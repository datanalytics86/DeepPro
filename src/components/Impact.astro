---
// Impact Section - McKinsey Style with Big Numbers
---

<section id="impacto" class="section-container bg-deeppro-dark text-white observe-fade relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <!-- Animated blobs for depth -->
  <div class="absolute top-20 right-20 w-96 h-96 bg-deeppro-cyan/10 blur-3xl blob parallax-slow"></div>
  <div class="absolute bottom-20 left-20 w-96 h-96 bg-blue-500/10 blur-3xl blob parallax-medium" style="animation-delay: 1.5s;"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-xl px-6 py-2 rounded-full mb-6">
        <svg class="w-4 h-4 text-deeppro-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
        </svg>
        <span class="text-sm font-semibold text-deeppro-cyan">Resultados Comprobados</span>
      </div>
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6">
        Impacto Medible
      </h2>
      <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto">
        Nuestros clientes experimentan mejoras cuantificables en eficiencia, toma de decisiones y resultados de negocio
      </p>
    </div>

    <!-- Big Numbers Grid with animated counters -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20" data-stagger>
      <!-- Metric 1 -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="text-center relative z-10">
          <div class="text-6xl md:text-7xl font-bold gradient-text mb-4 gradient-animate" data-count="-30%">
            -30%
          </div>
          <div class="text-lg font-semibold text-white mb-2">Reducción en Tiempo</div>
          <div class="text-sm text-gray-400">Generación de reportes automatizada</div>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="text-center relative z-10">
          <div class="text-6xl md:text-7xl font-bold gradient-text mb-4 gradient-animate" data-count="+45%">
            +45%
          </div>
          <div class="text-lg font-semibold text-white mb-2">Mejora en Precisión</div>
          <div class="text-sm text-gray-400">Decisiones basadas en datos reales</div>
        </div>
      </div>

      <!-- Metric 3 -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="text-center relative z-10">
          <div class="text-6xl md:text-7xl font-bold gradient-text mb-4 gradient-animate">
            <span data-count="10">10</span>x
          </div>
          <div class="text-lg font-semibold text-white mb-2">ROI Promedio</div>
          <div class="text-sm text-gray-400">Retorno en primer año</div>
        </div>
      </div>

      <!-- Metric 4 -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="text-center relative z-10">
          <div class="text-6xl md:text-7xl font-bold gradient-text mb-4 gradient-animate" data-count="100%">
            100%
          </div>
          <div class="text-lg font-semibold text-white mb-2">Satisfacción</div>
          <div class="text-sm text-gray-400">NPS score de clientes</div>
        </div>
      </div>
    </div>

    <!-- Detailed Impact Areas with stagger -->
    <div class="grid md:grid-cols-3 gap-8" data-stagger>
      <!-- Efficiency -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 p-8 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-deeppro-cyan to-blue-500 rounded-2xl flex items-center justify-center mb-6 glow-pulse">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Eficiencia Operacional</h3>
        <p class="text-gray-400 mb-6">
          Automatización de procesos manuales y eliminación de tareas repetitivas.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-deeppro-cyan flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Reducción de horas-hombre en reportes</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-deeppro-cyan flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Eliminación de errores manuales</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-deeppro-cyan flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Workflows optimizados</span>
          </li>
        </ul>
      </div>

      <!-- Insights -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 p-8 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center mb-6 glow-pulse">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Insights Accionables</h3>
        <p class="text-gray-400 mb-6">
          Visibilidad en tiempo real para decisiones informadas y estratégicas.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">KPIs en tiempo real</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Alertas proactivas</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Análisis predictivo</span>
          </li>
        </ul>
      </div>

      <!-- Scalability -->
      <div class="glass-card bg-white/5 backdrop-blur-xl border-white/10 p-8 tilt-card spotlight-card" data-stagger-item>
        <div class="tilt-card-glow"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center mb-6 glow-pulse">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Escalabilidad</h3>
        <p class="text-gray-400 mb-6">
          Soluciones que crecen con tu negocio sin requerir rediseño.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Arquitectura modular</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Expansión gradual</span>
          </li>
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-300">Integración continua</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- CTA with magnetic button -->
    <div class="mt-20 text-center">
      <a href="#contacto" class="btn-primary magnetic-btn inline-block">
        Descubre Tu Potencial de Mejora
        <svg class="inline-block w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
