---
// Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 dark:bg-black text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center space-x-2">
          <div class="w-10 h-10 bg-gradient-to-br from-deeppro-cyan to-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl">D</span>
          </div>
          <span class="font-bold text-xl">DeepPro</span>
        </div>
        <p class="text-gray-400 max-w-md">
          Transformando datos en decisiones. Soluciones de Business Intelligence y gestión de proyectos accesibles para empresas chilenas.
        </p>
        <div class="flex space-x-4">
          <a
            href="mailto:nicolas.andrade@deeppro.cl"
            class="w-10 h-10 bg-gray-800 hover:bg-deeppro-cyan rounded-lg flex items-center justify-center transition-colors"
            aria-label="Email"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </a>
          <a
            href="tel:+56987550637"
            class="w-10 h-10 bg-gray-800 hover:bg-deeppro-cyan rounded-lg flex items-center justify-center transition-colors"
            aria-label="Teléfono"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-bold mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li>
            <a href="#sobre-mi" class="text-gray-400 hover:text-deeppro-cyan transition-colors">
              Sobre Mí
            </a>
          </li>
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-deeppro-cyan transition-colors">
              Servicios
            </a>
          </li>
          <li>
            <a href="#casos" class="text-gray-400 hover:text-deeppro-cyan transition-colors">
              Casos de Éxito
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-gray-400 hover:text-deeppro-cyan transition-colors">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-bold mb-4">Servicios</h3>
        <ul class="space-y-2 text-gray-400">
          <li>Power BI</li>
          <li>Primavera P6</li>
          <li>Análisis de Datos</li>
          <li>Excel Avanzado</li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} DeepPro. Todos los derechos reservados.
      </p>
      <p class="text-gray-400 text-sm mt-4 md:mt-0">
        Nicolás Andrade - Consultoría BI & Gestión de Proyectos
      </p>
    </div>

    <!-- Back to Top Button -->
    <div class="text-center mt-8">
      <a
        href="#hero"
        class="inline-flex items-center space-x-2 text-gray-400 hover:text-deeppro-cyan transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
        <span class="text-sm">Volver arriba</span>
      </a>
    </div>
  </div>
</footer>
