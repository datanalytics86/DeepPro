---
// Footer Component - McKinsey Style
const currentYear = new Date().getFullYear();
---

<footer class="bg-gradient-to-br from-gray-900 via-gray-900 to-black text-white">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center space-x-3">
          <img src="/logo.svg" alt="DeepPro Logo" class="w-12 h-12" />
          <span class="font-bold text-2xl">
            <span class="text-gray-400">Deep</span><span class="text-deeppro-cyan">Pro</span>
          </span>
        </div>
        <p class="text-gray-400 max-w-md text-lg leading-relaxed">
          Transformando datos en decisiones estratégicas. Consultoría especializada en Business Intelligence y gestión de proyectos para empresas chilenas.
        </p>

        <!-- Contact Info -->
        <div class="space-y-3">
          <a href="mailto:nicolas.andrade@deeppro.cl" class="flex items-center space-x-3 text-gray-400 hover:text-deeppro-cyan transition-colors group">
            <div class="w-10 h-10 bg-gray-800 group-hover:bg-deeppro-cyan/20 rounded-lg flex items-center justify-center transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <span>nicolas.andrade@deeppro.cl</span>
          </a>
          <a href="tel:+56987550637" class="flex items-center space-x-3 text-gray-400 hover:text-deeppro-cyan transition-colors group">
            <div class="w-10 h-10 bg-gray-800 group-hover:bg-deeppro-cyan/20 rounded-lg flex items-center justify-center transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <span>+569 8755 0637</span>
          </a>
          <div class="flex items-center space-x-3 text-gray-400">
            <div class="w-10 h-10 bg-gray-800 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <span>Santiago, Chile</span>
          </div>
        </div>
      </div>

      <!-- Soluciones -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-white">Soluciones</h3>
        <ul class="space-y-3">
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Power BI
            </a>
          </li>
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Primavera P6
            </a>
          </li>
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Excel Avanzado
            </a>
          </li>
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Análisis de Datos
            </a>
          </li>
        </ul>
      </div>

      <!-- Industrias -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-white">Industrias</h3>
        <ul class="space-y-3">
          <li>
            <a href="#industrias" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Minería
            </a>
          </li>
          <li>
            <a href="#industrias" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Manufactura
            </a>
          </li>
          <li>
            <a href="#industrias" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Ingeniería
            </a>
          </li>
          <li>
            <a href="#industrias" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Servicios
            </a>
          </li>
        </ul>
      </div>

      <!-- Recursos -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-white">Recursos</h3>
        <ul class="space-y-3">
          <li>
            <a href="#sobre-mi" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Sobre DeepPro
            </a>
          </li>
          <li>
            <a href="#metodologia" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Metodología
            </a>
          </li>
          <li>
            <a href="#casos" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Casos de Éxito
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-gray-400 hover:text-deeppro-cyan transition-colors flex items-center group">
              <svg class="w-4 h-4 mr-2 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              Contacto
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Newsletter Section -->
    <div class="mt-16 pt-12 border-t border-gray-800">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl font-bold text-white mb-3">Mantente Informado</h3>
          <p class="text-gray-400">
            Recibe insights sobre BI, análisis de datos y mejores prácticas en gestión de proyectos.
          </p>
        </div>
        <div>
          <form class="flex gap-4">
            <input
              type="email"
              placeholder="tu@email.com"
              class="flex-1 px-6 py-4 bg-gray-800 border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-deeppro-cyan focus:border-transparent"
            />
            <button type="submit" class="btn-primary whitespace-nowrap">
              Suscribirse
            </button>
          </form>
          <p class="text-gray-500 text-sm mt-3">
            Al suscribirte, aceptas recibir comunicaciones de DeepPro. Sin spam, lo prometemos.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-gray-400 text-sm">
          © {currentYear} DeepPro. Todos los derechos reservados. Nicolás Andrade - Consultoría BI & Gestión de Proyectos
        </div>
        <div class="flex items-center gap-6">
          <a href="#hero" class="text-gray-400 hover:text-deeppro-cyan transition-colors text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
            Volver arriba
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
